model Notice {
  id         String         @id @default(uuid())
  title      String
  content    String
  audience   NoticeAudience
  postedById String
  postedBy   User           @relation(fields: [postedById], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([postedById])
  @@index([audience])
  @@map("notices")
}
