model Course {
  id           String           @id @default(uuid())
  courseCode   String           @unique
  title        String
  credits      Int
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id])
  offerings    CourseOffering[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([departmentId])
  @@map("courses")
}