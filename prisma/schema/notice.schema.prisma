model Notice {
  id       String         @id @default(uuid())
  title    String
  content  String
  audience NoticeAudience @default(ALL)

  postedByUserId String
  postedBy       User   @relation(fields: [postedByUserId], references: [id])

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([audience])
  @@index([deletedAt])
  @@map("notices")
}
