model Semester {
  id        String         @id @default(uuid())
  year      Int
  code      String         @unique
  startDate DateTime
  endDate   DateTime
  status    SemesterStatus @default(UPCOMING)

  courseOfferings  CourseOffering[]
  paymentsForSem   Payment[]
  studentsAdmitted Student[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
  @@index([deletedAt])
  @@map("semesters")
}
