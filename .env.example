# Copy this file to .env and fill in real values. Never commit .env.

# --- Server ---
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000

# Comma-separated list of origins allowed to call this API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (Prisma + PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --- Passwords ---
BCRYPT_SALT_ROUNDS=12

# --- JWT ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Google OAuth2 (Bearer idToken login) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Redis (caching, OTP-style short-lived keys) ---
REDIS_USER=default
REDIS_PASSWORD=replace-with-redis-password
REDIS_HOST=localhost
REDIS_PORT=6379

# --- bKash Tokenized Checkout (payment gateway) ---
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_USERNAME=replace-with-bkash-merchant-username
BKASH_PASSWORD=replace-with-bkash-merchant-password
BKASH_APP_KEY=replace-with-bkash-app-key
BKASH_APP_SECRET=replace-with-bkash-app-secret
# Where bKash redirects the payer's browser after checkout (must be a route this API exposes).
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/callback

# --- Cloudinary (profile image uploads) ---
CLOUDINARY_CLOUD_NAME=replace-with-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret

# --- Demo/seed accounts (used only by `npm run seed`) ---
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@university.edu
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

TESTER_ADMIN_NAME=Tester Admin
TESTER_ADMIN_EMAIL=tester.admin@university.edu
TESTER_ADMIN_PASSWORD=replace-with-a-strong-password

TESTER_FACULTY_NAME=Tester Faculty
TESTER_FACULTY_EMAIL=tester.faculty@university.edu
TESTER_FACULTY_PASSWORD=replace-with-a-strong-password

TESTER_STUDENT_NAME=Tester Student
TESTER_STUDENT_EMAIL=tester.student@university.edu
TESTER_STUDENT_PASSWORD=replace-with-a-strong-password
