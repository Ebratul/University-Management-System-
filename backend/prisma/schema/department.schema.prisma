model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  deletedAt DateTime?

  // Which university this department belongs to. Google sign-in needs it to match
  // the user's email domain. null = not assigned yet.
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])

  faculties Faculty[]
  courses   Course[]
  students  Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@index([universityId])
  @@map("departments")
}
