model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  deletedAt DateTime?

  faculties Faculty[]
  courses   Course[]
  students  Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
  @@map("departments")
}
