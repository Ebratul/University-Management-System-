model CourseOffering {
  id                  String  @id @default(uuid())
  maxSeats            Int     @default(40)
  // Which semester level (1st, 2nd, ...) of the department this is offered to.
  // null = open to every level of the course's department.
  semesterLevel       Int?
  registrationEnabled Boolean @default(true)

  courseId String
  course   Course @relation(fields: [courseId], references: [id])

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id])

  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])

  enrollments Enrollment[]
  materials   CourseMaterial[]
  attendances Attendance[]
  quizzes     Quiz[]

  registrationItems CourseRegistrationItem[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([courseId, semesterId, facultyId])
  @@index([semesterId])
  @@index([facultyId])
  @@index([deletedAt])
  @@map("course_offerings")
}
