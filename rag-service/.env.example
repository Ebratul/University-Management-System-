# --- Internal auth: the Node backend sends this in the X-Internal-Token header.
# Use the SAME value as RAG_SERVICE_TOKEN in backend/.env. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_SERVICE_TOKEN=replace-with-a-long-random-secret

# --- LLM + embeddings via OpenRouter (https://openrouter.ai/models)
OPENROUTER_API_KEY=replace-with-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenRouter chat model that supports tool calling / structured output.
OPENROUTER_MODEL=openai/gpt-4o-mini
# "openrouter" uses OpenRouter's embeddings endpoint; "fastembed" runs a small
# local ONNX model (pip install fastembed) and needs no API calls.
EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- LangSmith tracing (optional but recommended). Both the new LANGSMITH_*
# and the older LANGCHAIN_* names are read by the libraries.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-with-langsmith-api-key
LANGSMITH_PROJECT=ums-quiz-rag
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=ums-quiz-rag

# --- Service limits / storage
INDEX_DIR=./.index
# Only these hosts may be fetched as a document_url (comma separated).
ALLOWED_DOCUMENT_HOSTS=api.cloudinary.com,res.cloudinary.com
MAX_PDF_MB=20
MAX_PDF_PAGES=300
