# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Public (safe for the browser; inlined at build time) ---
# Public origin of this frontend. Used for metadata, canonical URLs and sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server only (never prefixed with NEXT_PUBLIC_) ---
# Express API. Local dev runs on port 5000 (see the backend README).
# On Vercel this is the Render URL, e.g. https://university-api.onrender.com
BACKEND_URL=http://localhost:5000

# Demo accounts for the one-click login buttons. These must match accounts that
# already exist in the backend database (created by `npm run seed` there).
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_FACULTY_EMAIL=
DEMO_FACULTY_PASSWORD=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
